# ---------------------------------------------------------------------------
# Supabase — auth, database, storage
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: used only by the cron routes and the content seed script.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# fal.ai — every generative model (text, image, video, speech)
# Without it the app runs in mock mode: generated pieces fall back to
# deterministic, template-built content instead of calling a model.
# ---------------------------------------------------------------------------
FAL_KEY=

# ---------------------------------------------------------------------------
# Email + scheduled jobs
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="IDSHIFT <noreply@idshift.app>"
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
